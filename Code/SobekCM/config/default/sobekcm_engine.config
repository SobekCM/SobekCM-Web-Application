          <Endpoint Segment="json-p" ComponentID="C11" Method="GetTheme" Protocol="JSON-P" />
          <Endpoint Segment="protobuf" ComponentID="C11" Method="GetTheme" Protocol="PROTOBUF" />
          <Endpoint Segment="xml" ComponentID="C11" Method="GetTheme" Protocol="XML" />
        </Path>
      </Path>
