      <Phrase Key="Definitions_Html"><![CDATA[<p>Os seguintes termos são definidos abaixo:</p>

<table width="600px" border="0" align="center">
  <tr>
    <td><a href="#Collection_Hierarchy">Hierarquia de Coleções</a></td>
    <td><a href="#Collection_Groups">Grupos de Coleções</a></td>
    <td><a href="#Collections">Coleções</a></td>
  </tr>
  <tr>
    <td><a href="#SubCollections">Subcoleções</a></td>
    <td><a href="#Views">Visualizações</a></td>
    <td><a href="#Visits">Visitas</a></td>
  </tr>
  <tr>
    <td><a href="#Main_Pages">Páginas Principais</a></td>
    <td><a href="#Browses">Navegações</a></td>
    <td><a href="#Titles_Items">Títulos e Itens</a></td>
  </tr>
