<?xml version="1.0" encoding="utf-8" ?>
<SobekCM_Config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://sobekrepository.org/schemas/sobekcm_config"
	xsi:schemaLocation="http://sobekrepository.org/schemas/sobekcm_config
		http://sobekrepository.org/schemas/sobekcm_config.xsd">
  <!-- Sparse by design — only phrases that historically had a real Spanish translation in code.
       Anything not listed here falls back to English automatically. -->
  <Localization Language="es">

    <Section Name="Common">
      <Phrase Key="Go_To">Ir a:</Phrase>
      <Phrase Key="First_Page">Primera Página</Phrase>
      <Phrase Key="Previous_Page">Página Anterior</Phrase>
      <Phrase Key="Next_Page">Página Siguiente</Phrase>
      <Phrase Key="Last_Page">Última Página</Phrase>
      <Phrase Key="First">Primero</Phrase>
      <Phrase Key="Previous">Anterior</Phrase>
      <Phrase Key="Next">Proximo</Phrase>
      <Phrase Key="Last">Último</Phrase>
    </Section>

    <Section Name="Text_Search">
      <Phrase Key="Search_This_Document">Buscar en este Objeto</Phrase>
      <Phrase Key="Your_Search_For">Su búsqueda dentro de el texto completo por paginas conteniendo </Phrase>
      <Phrase Key="And_Not"> Y NO </Phrase>
      <Phrase Key="And"> Y </Phrase>
      <Phrase Key="Or"> O </Phrase>
      <Phrase Key="Not">no </Phrase>
      <Phrase Key="Resulted_In"> resulto en </Phrase>
      <Phrase Key="Matching_Pages"> paginas correspondientes</Phrase>
      <Phrase Key="No_Matching_Pages">no paginas correspondientes</Phrase>
      <Phrase Key="Expand_Results">Usted puede ampliar sus resultados buscando por</Phrase>
      <Phrase Key="Restrict_Results">Usted puede disminuir sus resultados buscando por</Phrase>
    </Section>

    <Section Name="JPEG2000">
      <Phrase Key="Thumbnail">MINIATURA</Phrase>
    </Section>

    <Section Name="MultiVolumes">
      <Phrase Key="All_Volumes">Todos los Volumenes</Phrase>
      <Phrase Key="All_Issues">Todas las Ediciones</Phrase>
      <Phrase Key="Related_Map_Sets">Relacionado Mapa Conjuntos</Phrase>
    </Section>

    <Section Name="Related_Images">
      <Phrase Key="Thumbnails_Per_Page_Suffix">miniaturas por página</Phrase>
      <Phrase Key="Go_To_Thumbnail_Label">Ir a la miniatura</Phrase>
    </Section>

    <Section Name="Downloads">
      <Phrase Key="Explanation_Has_Downloads">Este objeto tiene las siguientes descargas:</Phrase>
    </Section>

  </Localization>
</SobekCM_Config>
