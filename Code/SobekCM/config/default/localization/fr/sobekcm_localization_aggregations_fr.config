      <Phrase Key="Author_Label">Auteur:</Phrase>
      <Phrase Key="Date_Label">Date:</Phrase>
      <Phrase Key="Description_Label">Description:</Phrase>
      <Phrase Key="Keywords_Label">Mots-clés:</Phrase>
      <Phrase Key="Html_Head_Info_Label">Informations d'en-tête HTML:</Phrase>
      <Phrase Key="Title_Help">Aide pour le champ du titre</Phrase>
      <Phrase Key="Author_Help">Aide pour le champ de l'auteur</Phrase>
      <Phrase Key="Date_Help">Aide pour le champ de la date</Phrase>
      <Phrase Key="Description_Help">Aide pour le champ de la description</Phrase>
      <Phrase Key="Keywords_Help">Aide pour le champ des mots-clés</Phrase>
      <Phrase Key="Extra_Head_Help">Aide pour le champ d'informations d'en-tête supplémentaires</Phrase>
      <Phrase Key="Cancel_Title">Ne pas appliquer les modifications</Phrase>
      <Phrase Key="Cancel_Button">ANNULER</Phrase>
      <Phrase Key="Save_Title">Enregistrer les modifications apportées au texte de cette page enfant</Phrase>
      <Phrase Key="Save_Button">ENREGISTRER</Phrase>
