<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SobekCM_Library</AssemblyName>
    <RootNamespace>SobekCM.Library</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- ClosedXML has NuGet support on .NET 6+ -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.Abstractions" Version="2.3.11" />
    <PackageReference Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.3" Condition="'$(OS)' == 'Windows_NT'" />
    <!-- No net-native TFM is published for this package; it only draws barcode images via
         System.Drawing.Imaging (Windows-only already, see System.Drawing.Common above), so the
         .NET Framework compatibility shim NuGet falls back to here is not a real risk -->
    <PackageReference Include="Zen.Barcode.Core" Version="2.0.0" NoWarn="NU1701" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legacy Web Forms files not yet converted; excluded until migration is complete -->
    <Compile Remove="ItemViewer\Viewers\Excluded\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SobekCM_Core\SobekCM_Core.csproj" />
    <ProjectReference Include="..\SobekCM_Engine_Library\SobekCM_Engine_Library.csproj" />
    <ProjectReference Include="..\SobekCM_Resource_Database\SobekCM_Resource_Database.csproj" />
    <ProjectReference Include="..\SobekCM_Resource_Object\SobekCM_Resource_Object.csproj" />
    <ProjectReference Include="..\SobekCM_Tools\SobekCM_Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Helpers\UploadiFive\" />
  </ItemGroup>

</Project>
