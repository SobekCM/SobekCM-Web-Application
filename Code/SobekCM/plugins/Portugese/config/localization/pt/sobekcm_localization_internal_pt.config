      <Phrase Key="Return_Home_Link">Clique aqui para voltar à página inicial da biblioteca digital.</Phrase>

      <Phrase Key="Wordmarks_Admin_Manage_Html"><![CDATA[Como você é um administrador, pode <a href="{0}">gerenciar os logotipos na tela de administração</a>.]]></Phrase>
