<?xml version="1.0" encoding="UTF-8" ?>
<SobekCM_Config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://sobekrepository.org/schemas/sobekcm_config"
        xsi:schemaLocation="http://sobekrepository.org/schemas/sobekcm_config
                             http://sobekrepository.org/schemas/sobekcm_config.xsd">

  <Connections>
    <!-- NOTE: If you change the database connection string in production, you need to restart the app pool/iis. -->
    <!--       If you change the database connection string in Visual Studio, you need to restart Visual Studio. -->
	<!--       You can also use integrated security here if you prefer.                                          -->
	  <Connection_String type="MSSQL" isHosted="true">data source=[DATABASE_SERVER];initial catalog=[DB_NAME];user id=[DB_USER];password=[DB_PASSWORD];TrustServerCertificate=True;Encrypt=True;</Connection_String>

  </Connections>

  <ErrorHandling>
    <ErrorEmails></ErrorEmails>
    <ErrorPage>http://192.168.7.63/error.html</ErrorPage>
  </ErrorHandling>
</SobekCM_Config>
