    <Section Name="Map_Common">
      <Phrase Key="Google_Maps_Not_Enabled_Html"><![CDATA[<p style="font-weight:bold; text-size:1.1em">ERROR: Google Maps are not enabled on this instance of SobekCM!</p>
<p>To enable them, please create a Google Map API key and enter it in the system-wide settings.</p>
<p>Information on this process can be found here: <a href="http://sobekrepository.org/software/config/googlemaps">http://sobekrepository.org/software/config/googlemaps</a>.</p>]]></Phrase>
    </Section>

    <Section Name="Map_Browse">
