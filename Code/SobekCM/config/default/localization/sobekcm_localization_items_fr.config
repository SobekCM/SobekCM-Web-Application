<?xml version="1.0" encoding="utf-8" ?>
<SobekCM_Config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://sobekrepository.org/schemas/sobekcm_config"
	xsi:schemaLocation="http://sobekrepository.org/schemas/sobekcm_config
		http://sobekrepository.org/schemas/sobekcm_config.xsd">
  <!-- Sparse by design — only phrases that historically had a real French translation in code.
       Anything not listed here falls back to English automatically. -->
  <Localization Language="fr">

    <Section Name="Common">
      <Phrase Key="Go_To">Aller à:</Phrase>
      <Phrase Key="First_Page">Première Page</Phrase>
      <Phrase Key="Previous_Page">Page Précédente</Phrase>
      <Phrase Key="Next_Page">Page Suivante</Phrase>
      <Phrase Key="Last_Page">Dernière Page</Phrase>
      <Phrase Key="First">Première</Phrase>
      <Phrase Key="Previous">Précédente</Phrase>
      <Phrase Key="Next">Suivante</Phrase>
      <Phrase Key="Last">Derniere</Phrase>
    </Section>

    <Section Name="Text_Search">
      <Phrase Key="Search_This_Document">Rechercher sur ce Document</Phrase>
      <Phrase Key="Your_Search_For">Votre recherche dans les textes intégrals pour les pages contenant </Phrase>
      <Phrase Key="And_Not"> ET PAS </Phrase>
      <Phrase Key="And"> ET </Phrase>
      <Phrase Key="Or"> OU </Phrase>
      <Phrase Key="Not">pas </Phrase>
      <Phrase Key="Resulted_In"> corresponde a </Phrase>
      <Phrase Key="Matching_Pages"> pages de résultats</Phrase>
      <Phrase Key="No_Matching_Pages">pas pages de résultats</Phrase>
      <Phrase Key="Expand_Results">Vous pouvez elaborer votre rechereche en cherchant par</Phrase>
      <Phrase Key="Restrict_Results">Vous pouvez limiter votre rechereche en cherchant par</Phrase>
    </Section>

    <Section Name="JPEG2000">
      <Phrase Key="Thumbnail">MINIATURE</Phrase>
    </Section>

    <Section Name="MultiVolumes">
      <Phrase Key="All_Volumes">Tous les Volumes</Phrase>
      <Phrase Key="All_Issues">Tous les Éditions</Phrase>
      <Phrase Key="Related_Map_Sets">Définit la Carte Connexes</Phrase>
    </Section>

    <Section Name="Related_Images">
      <Phrase Key="Thumbnails_Per_Page_Suffix">vignettes par page</Phrase>
      <Phrase Key="Go_To_Thumbnail_Label">Aller à l'Vignette</Phrase>
    </Section>

    <Section Name="Downloads">
      <Phrase Key="Explanation_Has_Downloads">Ce document est la suivante téléchargements:</Phrase>
    </Section>

  </Localization>
</SobekCM_Config>
