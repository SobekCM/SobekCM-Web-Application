<?xml version="1.0" encoding="utf-8" ?>
<SobekCM_Config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://sobekrepository.org/schemas/sobekcm_config"
	xsi:schemaLocation="http://sobekrepository.org/schemas/sobekcm_config
		http://sobekrepository.org/schemas/sobekcm_config.xsd">
  <!-- Sparse by design — only phrases that historically had a real French translation in code.
       Anything not listed here falls back to English automatically. -->
  <Localization Language="fr">

    <Section Name="Common">
      <Phrase Key="Go_To"><![CDATA[Aller à:]]></Phrase>
      <Phrase Key="First_Page"><![CDATA[Première Page]]></Phrase>
      <Phrase Key="Previous_Page"><![CDATA[Page Précédente]]></Phrase>
      <Phrase Key="Next_Page"><![CDATA[Page Suivante]]></Phrase>
      <Phrase Key="Last_Page"><![CDATA[Dernière Page]]></Phrase>
      <Phrase Key="First"><![CDATA[Première]]></Phrase>
      <Phrase Key="Previous"><![CDATA[Précédente]]></Phrase>
      <Phrase Key="Next"><![CDATA[Suivante]]></Phrase>
      <Phrase Key="Last"><![CDATA[Derniere]]></Phrase>
    </Section>

    <Section Name="Text_Search">
      <Phrase Key="Search_This_Document"><![CDATA[Rechercher sur ce Document]]></Phrase>
      <Phrase Key="Your_Search_For"><![CDATA[Votre recherche dans les textes intégrals pour les pages contenant ]]></Phrase>
      <Phrase Key="And_Not"><![CDATA[ ET PAS ]]></Phrase>
      <Phrase Key="And"><![CDATA[ ET ]]></Phrase>
      <Phrase Key="Or"><![CDATA[ OU ]]></Phrase>
      <Phrase Key="Not"><![CDATA[pas ]]></Phrase>
      <Phrase Key="Resulted_In"><![CDATA[ corresponde a ]]></Phrase>
      <Phrase Key="Matching_Pages"><![CDATA[ pages de résultats]]></Phrase>
      <Phrase Key="No_Matching_Pages"><![CDATA[pas pages de résultats]]></Phrase>
      <Phrase Key="Expand_Results"><![CDATA[Vous pouvez elaborer votre rechereche en cherchant par]]></Phrase>
      <Phrase Key="Restrict_Results"><![CDATA[Vous pouvez limiter votre rechereche en cherchant par]]></Phrase>
    </Section>

    <Section Name="JPEG2000">
      <Phrase Key="Thumbnail"><![CDATA[MINIATURE]]></Phrase>
    </Section>

    <Section Name="MultiVolumes">
      <Phrase Key="All_Volumes"><![CDATA[Tous les Volumes]]></Phrase>
      <Phrase Key="All_Issues"><![CDATA[Tous les Éditions]]></Phrase>
      <Phrase Key="Related_Map_Sets"><![CDATA[Définit la Carte Connexes]]></Phrase>
    </Section>

    <Section Name="Related_Images">
      <Phrase Key="Thumbnails_Per_Page_Suffix"><![CDATA[vignettes par page]]></Phrase>
      <Phrase Key="Go_To_Thumbnail_Label"><![CDATA[Aller à l'Vignette]]></Phrase>
    </Section>

    <Section Name="Downloads">
      <Phrase Key="Explanation_Has_Downloads"><![CDATA[Ce document est la suivante téléchargements:]]></Phrase>
    </Section>

  </Localization>
</SobekCM_Config>
