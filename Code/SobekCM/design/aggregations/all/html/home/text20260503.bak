<script>
    $(document).ready(function(){

       $("#tabContainer").acidTabs(1);

       load_info_page_content("tab1-content", "tab1");
	   load_info_page_content("tab2-content", "tab2");
	   load_info_page_content("tab3-content", "tab3");
	   load_info_page_content("tab4-content", "tab4");     
    });

    function load_info_page_content( local_div, remote_info_page )
    {
       var $mcontent = $( "#" + local_div );
       $mcontent.load( "<%BASEURL%>info/" + remote_info_page  + " #main-content", function() {  
                                                                    $mcontent.find("#sbkSbia_EditableTextLink").remove();
                                                            });     
    }

</script>
 