      <Phrase Key="No_Matches_Message"><![CDATA[Não houve correspondências dentro deste item para sua pesquisa geográfica. &nbsp; ]]></Phrase>
      <Phrase Key="Modify_Item_Search">Modificar pesquisa do item</Phrase>
      <Phrase Key="Modify_Search_Within_Flight">Modificar pesquisa dentro do voo</Phrase>
