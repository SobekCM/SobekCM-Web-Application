<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS-specific settings only. All application configuration lives in appsettings.json.
  When publishing with 'dotnet publish', the aspNetCore handler entry is added automatically.
-->
<configuration>
  <system.webServer>
    <security>
      <!-- IIS enforces this limit before ASP.NET Core sees the request; keep in sync with Kestrel:Limits:MaxRequestBodySize in appsettings.json -->
      <requestFiltering>
        <requestLimits maxAllowedContentLength="2147483648"/>
      </requestFiltering>
    </security>
    <staticContent>
      <!-- Applies when IIS serves static files directly (inprocess hosting) -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="10.00:00:00"/>
      <mimeMap fileExtension=".glsl" mimeType="application/octet-stream"/>
    </staticContent>
    <directoryBrowse enabled="false"/>
  </system.webServer>
</configuration>
