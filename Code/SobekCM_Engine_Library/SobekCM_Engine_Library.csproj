<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SobekCM_Engine_Library</AssemblyName>
    <RootNamespace>SobekCM.Engine_Library</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="protobuf-net" Version="3.2.30" />
    <!-- ASP.NET Core HTTP types replace System.Web.HttpContext in endpoint handlers -->
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
    <!-- IHostApplicationLifetime for AppLifetime_Gateway (extension-toggle-triggered restarts) -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.0" />

    <!-- Not OS-conditioned: the package itself compiles fine on any platform (only specific GDI+ calls
         throw PlatformNotSupportedException on non-Windows at runtime). AggregationServices.cs guards
         its Bitmap/Graphics usage with OperatingSystem.IsWindowsVersionAtLeast(6, 1) already - excluding
         the package from non-Windows restore would just break the build there instead. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EngineAgnosticLayerDbAccess\EngineAgnosticLayerDbAccess.csproj" />
    <ProjectReference Include="..\SobekCM_Core\SobekCM_Core.csproj" />
    <ProjectReference Include="..\SobekCM_Resource_Database\SobekCM_Resource_Database.csproj" />
    <ProjectReference Include="..\SobekCM_Resource_Object\SobekCM_Resource_Object.csproj" />
    <ProjectReference Include="..\SobekCM_Tools\SobekCM_Tools.csproj" />
  </ItemGroup>

</Project>
