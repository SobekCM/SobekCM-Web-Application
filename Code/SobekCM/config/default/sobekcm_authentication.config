<?xml version="1.0" encoding="utf-8" ?>
<SobekCM_Config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://sobekrepository.org/schemas/sobekcm_config"
	xsi:schemaLocation="http://sobekrepository.org/schemas/sobekcm_config
		http://sobekrepository.org/schemas/sobekcm_config.xsd">
  <!-- Three optional attributes on this <Authentication> element control the built-in SobekCM
       username/password (local database) logon.  All three default to true if omitted.

       AllowLocalAuth         Master switch.  "false" means no local account can log on at all, anywhere,
                              and self-registration is off, regardless of the two attributes below.

       AllowSelfRegistration  "false" hides the "Register Now" links on the logon page, and both the standard
                              and OpenNJ register viewers redirect back to logon instead of rendering.

       ShowLocalLogon         "false" removes the local username/password option from the standard logon
                              screen, so it only offers the OIDC/SAML/Shibboleth sign-in links.  Local accounts
                              can still log on through the unlinked my/logon/local page (an inline form, no
                              popup), e.g. for SobekDigital staff or automated smoke tests.  To stop a
                              particular local account from logging on, set isActive to false on that user.

       Typical SSO-only instance:
         <Authentication AllowSelfRegistration="false" ShowLocalLogon="false"> -->
  <Authentication>

    <!-- Optional captcha (Cloudflare Turnstile) on the anonymous forms: self-registration (standard and
         OpenNJ) and the contact form, which is also where "forgot your password" sends people.  Create a
         Turnstile widget in the Cloudflare dashboard (free; the site does NOT need to be behind Cloudflare,
         and one widget can list several hostnames) and paste its keys here.  The captcha is only shown and
         enforced when the element is present, Enabled is not "false", and BOTH keys are filled in - so with
         no element at all, the forms behave exactly as before.  Set the secret key here, never in a page.
         Cloudflare's test keys, for trying it out: SiteKey 1x00000000000000000000AA with SecretKey
         1x0000000000000000000000000000000AA always passes; SecretKey 2x0000000000000000000000000000000AA
         always fails.  Failed and missing captchas are logged as CAPTCHA FAIL in temp/ratelimiting.txt.

    <captcha Provider="turnstile" SiteKey="[SITE KEY]" SecretKey="[SECRET KEY]" Enabled="true" />
    -->

    <!-- One <provider> per OpenID Connect identity provider (Google, Microsoft Entra, Okta, ...).
         ProviderCode is used both as the ASP.NET Core authentication scheme name and as the
         "/my/oidc/{ProviderCode}" URL segment, so it must be unique and URL-safe.
-->
    <oidc>
      <provider ProviderCode="google" Label="Google" Authority="https://accounts.google.com"
                ClientId="[CLIENT ID]" ClientSecret="[CLIENT SECRET]" Enabled="true">
        <mapping Name="email" UserAttribute="EMAIL" />
        <mapping Name="given_name" UserAttribute="FIRSTNAME" />
        <mapping Name="family_name" UserAttribute="LASTNAME" />
      </provider>
    </oidc>
    

    <!-- One <provider> per SAML identity provider, handled via Sustainsys.Saml2. ProviderCode is
         used both as the authentication scheme name and as the "/my/saml/{ProviderCode}" URL segment.
         EntityId is THIS application's own identifier, chosen locally and given to the identity
         provider to register as a trusted SP. IdpEntityId is the IDENTITY PROVIDER's own entity ID
         (the entityID attribute on its metadata's EntityDescriptor) — get this from the IdP, it is
         not the same value as EntityId. Sustainsys.Saml2 validates IdpEntityId against the metadata
         loaded from IdpMetadataUrl and throws if they don't match. Give the IdP admin the Reply URL
         (Assertion Consumer Service URL) "https://<this host>/my/saml/{ProviderCode}/sso/Acs" to register.

    <saml>
      <provider ProviderCode="our-idp" Label="Our SAML IdP" IdpMetadataUrl="https://idp.example.com/metadata"
                EntityId="https://this-site.example.com/saml" IdpEntityId="https://idp.example.com/entity-id" Enabled="true">
        <mapping Name="http://schemas.xmlsoap.org/ws/2005/05/identity/claims/emailaddress" UserAttribute="EMAIL" />
        <mapping Name="http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname" UserAttribute="FIRSTNAME" />
        <mapping Name="http://schemas.xmlsoap.org/ws/2005/05/identity/claims/surname" UserAttribute="LASTNAME" />
      </provider>
    </saml>
    -->
    <saml>
    </saml>

  </Authentication>
</SobekCM_Config>
