      <Phrase Key="Return_Home_Link">Haga clic aquí para volver a la página principal de la biblioteca digital.</Phrase>

      <Phrase Key="Wordmarks_Admin_Manage_Html"><![CDATA[Como es administrador, puede <a href="{0}">administrar los logotipos desde la pantalla de administración</a>.]]></Phrase>
