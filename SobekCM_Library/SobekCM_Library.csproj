<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SobekCM_Library</AssemblyName>
    <RootNamespace>SobekCM.Library</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- ClosedXML has NuGet support on .NET 6+ -->
    <PackageReference Include="ClosedXML" Version="0.105.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.3" Condition="'$(OS)' == 'Windows_NT'" />
    <!-- Zen.Barcode.Core: check for .NET 6+ compatible NuGet; kept as DLL for now -->
    <Reference Include="Zen.Barcode.Core">
      <HintPath>..\DLLs\Zen.Barcode.Core.dll</HintPath>
    </Reference>
    <!-- System.Web compatibility shim for ASP.NET Core migration — provides HttpContext.Current, Request, Session, etc. -->
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
    <!-- System.Runtime.Caching replaces System.Web.Caching.Cache -->
    <PackageReference Include="System.Runtime.Caching" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legacy Web Forms files not yet converted; excluded until migration is complete -->
    <Compile Remove="ItemViewer\Viewers\Excluded\**\*.cs" />
    <Compile Remove="SobekCM_Library_Settings_BACKUP.cs" />
    <!-- Duplicate class moved to WebContentViewer/Viewers/ -->
    <Compile Remove="AdminViewer\Work_History_WebContentViewer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SobekCM_Core\SobekCM_Core.csproj" />
    <ProjectReference Include="..\SobekCM_Engine_Library\SobekCM_Engine_Library.csproj" />
    <ProjectReference Include="..\SobekCM_Resource_Database\SobekCM_Resource_Database.csproj" />
    <ProjectReference Include="..\SobekCM_Resource_Object\SobekCM_Resource_Object.csproj" />
    <ProjectReference Include="..\SobekCM_Tools\SobekCM_Tools.csproj" />
  </ItemGroup>

</Project>
