<?xml version="1.0" encoding="utf-8"?>
<!--
  IIS-specific settings only. All application configuration lives in appsettings.json.
  When publishing with 'dotnet publish', the aspNetCore handler entry is added automatically.
-->
<configuration>
  <system.webServer>
    <security>
      <!-- IIS enforces this limit before ASP.NET Core sees the request; keep in sync with Kestrel:Limits:MaxRequestBodySize in appsettings.json -->
      <requestFiltering>
        <requestLimits maxAllowedContentLength="104857600"/>
      </requestFiltering>
    </security>
    <directoryBrowse enabled="false"/>
  </system.webServer>
</configuration>
