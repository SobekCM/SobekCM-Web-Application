<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SobekCM</AssemblyName>
    <RootNamespace>SobekCM</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.3" Condition="'$(OS)' == 'Windows_NT'" />
    <!-- SystemWebAdapters provides HttpContext.Current, HttpRequest, HttpSessionState, etc. backed by ASP.NET Core -->
    <PackageReference Include="Microsoft.AspNetCore.SystemWebAdapters" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Legacy Web Forms code-behind files excluded — replaced by Program.cs and minimal API endpoints -->
    <Compile Remove="Dashboard.aspx.cs" />
    <Compile Remove="Dashboard.aspx.designer.cs" />
    <Compile Remove="Files.aspx.cs" />
    <Compile Remove="Files.aspx.designer.cs" />
    <Compile Remove="SobekCM.aspx.cs" />
    <Compile Remove="SobekCM.aspx.designer.cs" />
    <Compile Remove="SobekCM_data.aspx.cs" />
    <Compile Remove="SobekCM_Data.aspx.designer.cs" />
    <Compile Remove="SobekCM_oai.aspx.cs" />
    <Compile Remove="SobekCM_OAI.aspx.designer.cs" />
    <Compile Remove="HtmlEditFileHandler.ashx.cs" />
    <Compile Remove="UploadiFiveFileHandler.ashx.cs" />
    <Compile Remove="Global.asax.cs" />
    <Compile Remove="default\callbacks\CallBacks.aspx.cs" />
    <Compile Remove="default\callbacks\CallBacks.aspx.designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SobekCM_Core\SobekCM_Core.csproj" />
    <ProjectReference Include="..\SobekCM_Engine_Library\SobekCM_Engine_Library.csproj" />
    <ProjectReference Include="..\SobekCM_Library\SobekCM_Library.csproj" />
    <ProjectReference Include="..\SobekCM_Resource_Object\SobekCM_Resource_Object.csproj" />
    <ProjectReference Include="..\SobekCM_Tools\SobekCM_Tools.csproj" />
    <ProjectReference Include="..\SobekCM_URL_Rewriter\SobekCM_URL_Rewriter.csproj" />
  </ItemGroup>

</Project>
