# Copy this file to .env and fill in real values. .env is git-ignored.

BASE_URL=https://demo.sobeklibrary.com

# Credentials for a dedicated, low-privilege test account -- do not use a real/admin account.
SOBEKCM_TEST_USERNAME=
SOBEKCM_TEST_PASSWORD=

# "true" for a private site (RequireLogon="true" in sobekcm_authentication.config). Every smoke test then
# runs logged on, through the unlinked my/logon/local page with the account above.
SOBEKCM_REQUIRES_LOGON=
