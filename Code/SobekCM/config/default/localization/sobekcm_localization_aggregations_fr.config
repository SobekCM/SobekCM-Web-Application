<?xml version="1.0" encoding="utf-8" ?>
<SobekCM_Config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://sobekrepository.org/schemas/sobekcm_config"
	xsi:schemaLocation="http://sobekrepository.org/schemas/sobekcm_config
		http://sobekrepository.org/schemas/sobekcm_config.xsd">
  <!-- Sparse by design — only phrases that historically had a real French translation in code.
       Anything not listed here falls back to English automatically. -->
  <Localization Language="fr">

    <Section Name="Aggregation_Common">
      <Phrase Key="Search_Collection">Recherche dans la collection</Phrase>
      <Phrase Key="Quick_Tips_Html"><![CDATA[<div id="sbk_QuickTips">
  <h1>Conseils rapides</h1>
  <ul>
    <li>La Recherche Booléenne
      <p class="tagline"> Utilisez <b>+</b> ou <i><b>et</b></i> des termes et de trouver des documents avec <b>tous</b> les termes.<br />
      Utilisez <b>-</b> ou <i><b>ou</b></i> entre les termes ou pour rechercher des enregistrements avec <b>l'un</b> des termes.<br />
      Utilisez <b>!</b> ou <i><b>et not</b></i> entre les termes à exclure des enregistrements avec des termes.<br />
      Si rien n'est indiqué, <i><b>et</b></i> est la valeur par défaut.<br />
      EXEMPLE: naturelle et non histoire
      </p>
    </li>
    <li>Recherche d'une Expression
      <p class="tagline"> Placer des guillemets autour d'une phrase recherchera la phrase exacte.<br />
      EXEMPLE: &laquo;histoire naturelle&raquo;</p>
    </li>
    <li>Capitalisation
      <p class="tagline"> Les recherches ne sont pas la capitalisation sensible.<br />
      EXEMPLE: La recherche de <i>NATUREL</i> rendra les mêmes résultats que la recherche de naturel <i>naturel</i></p>
    </li>
    <li>Les Signes Diacritiques
      <p class="tagline"> Pour rechercher des mots avec des signes diacritiques, le caractère doit être entré dans la zone de recherche.<br />
      EXEMPLE: La recherche de <i>Précédent</i> est différente de <i>Precedent</i></p>
    </li>
  </ul>
</div>
<br />]]></Phrase>
    </Section>

    <Section Name="Advanced_Search">
      <Phrase Key="Search_For">Recherche de:</Phrase>
      <Phrase Key="In">en</Phrase>
      <Phrase Key="And">et</Phrase>
      <Phrase Key="Or">ou</Phrase>
      <Phrase Key="And_Not">et non</Phrase>
    </Section>

    <Section Name="Full_Text_Search">
      <Phrase Key="Search_Full_Text">Recherche dans la collection</Phrase>
    </Section>

    <Section Name="DLOC_Search">
      <Phrase Key="Include_Newspapers">Accès aux journaux inclus?</Phrase>
    </Section>

  </Localization>
</SobekCM_Config>
