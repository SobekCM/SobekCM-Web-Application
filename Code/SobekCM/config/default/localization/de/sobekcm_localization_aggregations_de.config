      <Phrase Key="Keywords_Label">Schlagwörter:</Phrase>
      <Phrase Key="Html_Head_Info_Label">HTML-Head-Informationen:</Phrase>
      <Phrase Key="Title_Help">Hilfe zum Platzhalter für den Titel</Phrase>
      <Phrase Key="Author_Help">Hilfe zum Platzhalter für den Autor</Phrase>
