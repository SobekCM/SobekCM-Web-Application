<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SobekCM_Stats_Backfill</AssemblyName>
    <RootNamespace>SobekCM.Stats_Backfill</RootNamespace>
    <Nullable>disable</Nullable>
    <!-- Prevents dozens of per-locale satellite resource DLLs (translated exception messages
         only, e.g. from ICU4N/SqlClient) from being copied into the build output -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Code\SobekCM_Builder_Library\SobekCM_Builder_Library.csproj" />
    <ProjectReference Include="..\..\Code\SobekCM_Core\SobekCM_Core.csproj" />
    <ProjectReference Include="..\..\Code\SobekCM_Engine_Library\SobekCM_Engine_Library.csproj" />
    <ProjectReference Include="..\..\Code\EngineAgnosticLayerDbAccess\EngineAgnosticLayerDbAccess.csproj" />
  </ItemGroup>

</Project>
