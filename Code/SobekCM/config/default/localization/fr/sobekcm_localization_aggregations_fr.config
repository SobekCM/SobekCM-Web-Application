      <Phrase Key="Definitions_Html"><![CDATA[<p>Les termes suivants sont définis ci-dessous :</p>

<table width="600px" border="0" align="center">
  <tr>
    <td><a href="#Collection_Hierarchy">Hiérarchie des collections</a></td>
    <td><a href="#Collection_Groups">Groupes de collections</a></td>
