{
  "Kestrel": {
    "Limits": {
      "MaxRequestBodySize": 2147483648
    }
  },
  "Session": {
    "IdleTimeoutMinutes": 90
  },
  "ErrorHandling": {
    "RemoteErrorPage": "https://sobekdigital.com/customer-site/demo/error/",
    "SuppressTraceFiles": false
  },
  "OpenTelemetry": {
    "OtlpEndpoint": "https://telemetry.googleapis.com/v1/traces",
  "GoogleCloudProjectId": "[PUT-GOOGLE-CLOUD-PROJECTID-HERE]"
  },
  "GCS": {
    "ServiceAccountJsonPath": "C:/SobekCM/Keys/gcs-service-account.json"
  },
  "ImageServer": {
    "SharedKeyPath": "C:/SobekCM/Keys/image-server-shared-key.txt"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
