<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SobekCM</AssemblyName>
    <RootNamespace>SobekCM</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Prevents dozens of per-locale satellite resource DLLs (translated exception messages
         only, e.g. from ICU4N/SqlClient) from being copied into the publish output -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- .pdb files still get built (so local debugging works), just not shipped to the publish
         output; they add bulk and embed dev-machine source paths for no production benefit.
         CopyOutputSymbolsToPublishDirectory only covers this project's own .pdb; the referenced
         projects' .pdb files ride along as "related files" of their DLLs, suppressed separately here. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    <AllowedReferenceRelatedFileExtensions>none</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
    <PackageReference Include="Sustainsys.Saml2.AspNetCore2" Version="2.11.0" />
    <PackageReference Include="System.Drawing.Common" Version="9.0.3" Condition="'$(OS)' == 'Windows_NT'" />
  </ItemGroup>

  <ItemGroup>
    <!-- The SDK's implicit globbing only classifies .config/.json files under here as Content
         (CopyToPublishDirectory metadata); everything else (js/css/images/html/...) becomes a
         plain None item, which is never copied to the publish output. Reclassify both folders
         wholesale as Content so `dotnet publish` actually ships the site's runtime assets. -->
    <Content Remove="default\**" />
    <None Remove="default\**" />
    <Content Include="default\**" CopyToPublishDirectory="PreserveNewest" />

    <Content Remove="config\**" />
    <None Remove="config\**" />
    <Content Include="config\**" CopyToPublishDirectory="PreserveNewest" />

    <!-- Only read locally when ASPNETCORE_ENVIRONMENT=Development; a real server never loads
         it, so keep it out of the publish output rather than ship dev-only settings -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SobekCM_Core\SobekCM_Core.csproj" />
    <ProjectReference Include="..\SobekCM_Engine_Library\SobekCM_Engine_Library.csproj" />
    <ProjectReference Include="..\SobekCM_Library\SobekCM_Library.csproj" />
    <ProjectReference Include="..\SobekCM_Resource_Object\SobekCM_Resource_Object.csproj" />
    <ProjectReference Include="..\SobekCM_Tools\SobekCM_Tools.csproj" />
  </ItemGroup>

</Project>
