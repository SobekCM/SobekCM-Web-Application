<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SobekCM_Resource_Object</AssemblyName>
    <RootNamespace>SobekCM.Resource_Object</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Data.SqlClient types moved to Microsoft.Data.SqlClient in .NET Core -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
    <PackageReference Include="protobuf-net" Version="3.2.30" />
    <!-- Not OS-conditioned: the package itself compiles fine on any platform (only specific GDI+ calls
         throw PlatformNotSupportedException on non-Windows at runtime). SobekCM_File_Info.cs and
         SobekCM_METS_Validator.cs guard their Bitmap/Image usage with OperatingSystem.IsWindowsVersionAtLeast(6, 1)
         already - excluding the package from non-Windows restore would just break the build there instead. -->
    <PackageReference Include="System.Drawing.Common" Version="9.0.3" />
    <!-- Zoom.Net (Z39.50) has no NuGet equivalent; keep as DLL reference until replacement is identified -->
    <Reference Include="Zoom.Net">
      <HintPath>..\DLLs\Zoom.net\Zoom.Net.dll</HintPath>
    </Reference>
    <Reference Include="Zoom.Net.YazSharp">
      <HintPath>..\DLLs\Zoom.net\Zoom.Net.YazSharp.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SobekCM_Tools\SobekCM_Tools.csproj" />
  </ItemGroup>

</Project>
