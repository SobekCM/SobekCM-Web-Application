<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Solr_Reindexer</AssemblyName>
    <RootNamespace>Solr_Reindexer</RootNamespace>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Prevents dozens of per-locale satellite resource DLLs (translated exception messages
         only, e.g. from ICU4N/SqlClient) from being copied into the build output -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Drawing.Common" Version="9.0.3" Condition="'$(OS)' == 'Windows_NT'" />
    <PackageReference Include="sautinsoft.useoffice" Version="2026.4.22" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Code\SobekCM_Builder_Library\SobekCM_Builder_Library.csproj" />
    <ProjectReference Include="..\..\Code\SobekCM_Core\SobekCM_Core.csproj" />
    <ProjectReference Include="..\..\Code\SobekCM_Engine_Library\SobekCM_Engine_Library.csproj" />
    <ProjectReference Include="..\..\Code\SobekCM_Resource_Object\SobekCM_Resource_Object.csproj" />
    <ProjectReference Include="..\..\Code\SobekCM_Tools\SobekCM_Tools.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="app.config" />
  </ItemGroup>

</Project>
