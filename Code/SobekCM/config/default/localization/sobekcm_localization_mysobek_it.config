    <Section Name="Home">
      <Phrase Key="Welcome_New_User_Format">Benvenuto su mia{0}, {1}</Phrase>
      <Phrase Key="Welcome_Back_Format">Bentornato, {0}</Phrase>
      <Phrase Key="Welcome_Intro_Format">Benvenuto su {0}. Questa funzione ti consente di aggiungere articoli alle tue scaffalature, organizzarle e inviarle via email agli amici.</Phrase>
