<?xml version="1.0" encoding="UTF-8" ?>
<SobekCM_Config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://sobekrepository.org/schemas/sobekcm_config"
	xsi:schemaLocation="http://sobekrepository.org/schemas/sobekcm_config
		http://sobekrepository.org/schemas/sobekcm_config.xsd">
	<Connections>
		<!-- CHOOSE ONE OF THE CONNECTION STRING TYPES BELOW -->
	
		<!-- NOTE: If you change the database connection string in production, you need to restart the app pool/iis. -->
		<!--       If you change the database connection string in Visual Studio, you need to restart Visual Studio. -->
		<Connection_String type="MSSQL" isHosted="false">data source=[SQL Instance];initial catalog=[DatabaseName];integrated security=Yes;</Connection_String>
		
		<Connection_String  type="MSSQL" isHosted="false">data source=[SQL_Instance];initial catalog=[DatabaseName];user id=[User];password=[Password];TrustServerCertificate=True;Encrypt=False;</Connection_String>
	</Connections>

	<ErrorHandling>
		<ErrorEmails>[EmailAddress]</ErrorEmails>
		<ErrorPage>[CustomErrorPage]</ErrorPage>
	</ErrorHandling>

</SobekCM_Config>