<?xml version="1.0" encoding="utf-8" ?>
<SobekCM_Config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns="http://sobekrepository.org/schemas/sobekcm_config"
	xsi:schemaLocation="http://sobekrepository.org/schemas/sobekcm_config
		http://sobekrepository.org/schemas/sobekcm_config.xsd">
  <!-- Sparse by design — only phrases that historically had a real Spanish translation in code.
       Anything not listed here falls back to English automatically. -->
  <Localization Language="es">

    <Section Name="Common">
      <Phrase Key="Go_To"><![CDATA[Ir a:]]></Phrase>
      <Phrase Key="First_Page"><![CDATA[Primera Página]]></Phrase>
      <Phrase Key="Previous_Page"><![CDATA[Página Anterior]]></Phrase>
      <Phrase Key="Next_Page"><![CDATA[Página Siguiente]]></Phrase>
      <Phrase Key="Last_Page"><![CDATA[Última Página]]></Phrase>
      <Phrase Key="First"><![CDATA[Primero]]></Phrase>
      <Phrase Key="Previous"><![CDATA[Anterior]]></Phrase>
      <Phrase Key="Next"><![CDATA[Proximo]]></Phrase>
      <Phrase Key="Last"><![CDATA[Último]]></Phrase>
    </Section>

    <Section Name="Text_Search">
      <Phrase Key="Search_This_Document"><![CDATA[Buscar en este Objeto]]></Phrase>
      <Phrase Key="Your_Search_For"><![CDATA[Su búsqueda dentro de el texto completo por paginas conteniendo ]]></Phrase>
      <Phrase Key="And_Not"><![CDATA[ Y NO ]]></Phrase>
      <Phrase Key="And"><![CDATA[ Y ]]></Phrase>
      <Phrase Key="Or"><![CDATA[ O ]]></Phrase>
      <Phrase Key="Not"><![CDATA[no ]]></Phrase>
      <Phrase Key="Resulted_In"><![CDATA[ resulto en ]]></Phrase>
      <Phrase Key="Matching_Pages"><![CDATA[ paginas correspondientes]]></Phrase>
      <Phrase Key="No_Matching_Pages"><![CDATA[no paginas correspondientes]]></Phrase>
      <Phrase Key="Expand_Results"><![CDATA[Usted puede ampliar sus resultados buscando por]]></Phrase>
      <Phrase Key="Restrict_Results"><![CDATA[Usted puede disminuir sus resultados buscando por]]></Phrase>
    </Section>

    <Section Name="JPEG2000">
      <Phrase Key="Thumbnail"><![CDATA[MINIATURA]]></Phrase>
    </Section>

    <Section Name="MultiVolumes">
      <Phrase Key="All_Volumes"><![CDATA[Todos los Volumenes]]></Phrase>
      <Phrase Key="All_Issues"><![CDATA[Todas las Ediciones]]></Phrase>
      <Phrase Key="Related_Map_Sets"><![CDATA[Relacionado Mapa Conjuntos]]></Phrase>
    </Section>

    <Section Name="Related_Images">
      <Phrase Key="Thumbnails_Per_Page_Suffix"><![CDATA[miniaturas por página]]></Phrase>
      <Phrase Key="Go_To_Thumbnail_Label"><![CDATA[Ir a la miniatura]]></Phrase>
    </Section>

    <Section Name="Downloads">
      <Phrase Key="Explanation_Has_Downloads"><![CDATA[Este objeto tiene las siguientes descargas:]]></Phrase>
    </Section>

  </Localization>
</SobekCM_Config>
