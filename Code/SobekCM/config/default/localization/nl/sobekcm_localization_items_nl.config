      <Phrase Key="End_Processing_Label">Einde Verwerking</Phrase>
    </Section>

    <Section Name="UF_Media">
      <Phrase Key="No_Info_Message">ITEM IS NIET GEARCHIVEERD OP MEDIA</Phrase>
      <Phrase Key="Table_Title">CD/DVD-ARCHIEF</Phrase>
